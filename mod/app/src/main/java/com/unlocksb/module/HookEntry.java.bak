package com.unlocksb.module;

import android.os.Bundle;
import android.util.Log;

import java.lang.reflect.Field;
import java.lang.reflect.Method;

import io.github.libxposed.api.XposedModule;
import io.github.libxposed.api.XposedModuleInterface;

public class HookEntry extends XposedModule {
    private static final String TAG = "SBNoLogin";
    private static final String PKG = "org.swiftapps.swiftbackup";

    // 缓存反射对象
    private static Object cachedVInstance = null;
    private static Method cachedGetNon = null;
    private static Method cachedSetNon = null;
    private static Object cachedAnonHelper = null;
    private static Method cachedAnonDMethod = null;

    @Override
    public void onPackageLoaded(XposedModuleInterface.PackageLoadedParam param) {
        if (!PKG.equals(param.getPackageName())) {
            return;
        }
        ClassLoader cl = param.getDefaultClassLoader();
        try {
            hookIsAnonymous(cl);
            hookAutoLogin(cl);
        } catch (Throwable t) {
            Log.e(TAG, "hook setup failed", t);
        }
    }

    private void hookIsAnonymous(ClassLoader cl) {
        try {
            // 动态查找 MFirebaseUser 类
            Class<?> mfuCls = findClass(cl, "org.swiftapps.swiftbackup.anonymous.MFirebaseUser");
            if (mfuCls == null) {
                Log.d(TAG, "MFirebaseUser not found, skip isAnonymous hook");
                return;
            }
            Method isAnon = mfuCls.getDeclaredMethod("isAnonymous");
            hook(isAnon).setPriority(100).before(chain -> {
                Log.d(TAG, "MFirebaseUser.isAnonymous -> false");
                return false;
            });
            Log.d(TAG, "MFirebaseUser.isAnonymous hooked");
        } catch (Throwable t) {
            Log.e(TAG, "hookIsAnonymous failed", t);
        }
    }

    private void hookAutoLogin(ClassLoader cl) {
        try {
            // 动态查找 IntroActivity，支持多个可能的类名
            Class<?> introCls = findClass(cl, "org.swiftapps.swiftbackup.intro.IntroActivity");
            if (introCls == null) {
                introCls = findClass(cl, "org.swiftapps.swiftbackup.activities.IntroActivity");
            }
            if (introCls == null) {
                introCls = findClass(cl, "org.swiftapps.swiftbackup.ui.IntroActivity");
            }
            if (introCls == null) {
                Log.d(TAG, "IntroActivity not found, skip auto login hook");
                return;
            }

            Method onCreate = introCls.getDeclaredMethod("onCreate", Bundle.class);
            hook(onCreate).setPriority(100).before(chain -> {
                ensureLoggedIn(cl);
                return chain.proceed();
            });
            Log.d(TAG, "IntroActivity.onCreate hooked");
        } catch (Throwable t) {
            Log.e(TAG, "hookAutoLogin failed", t);
        }
    }

    private void ensureLoggedIn(ClassLoader cl) {
        try {
            // 1. 找 V 类（支持多个可能的类名）
            Class<?> vCls = findClass(cl, "org.swiftapps.swiftbackup.common.V");
            if (vCls == null) {
                vCls = findClass(cl, "org.swiftapps.swiftbackup.common.v");
            }
            if (vCls == null) {
                Log.d(TAG, "V class not found");
                return;
            }

            // 2. 获取 INSTANCE
            if (cachedVInstance == null) {
                Field inst = vCls.getDeclaredField("INSTANCE");
                inst.setAccessible(true);
                cachedVInstance = inst.get(null);
            }
            if (cachedVInstance == null) {
                Log.d(TAG, "V.INSTANCE is null");
                return;
            }

            // 3. 获取 getNon 方法
            if (cachedGetNon == null) {
                cachedGetNon = vCls.getDeclaredMethod("getNon");
                cachedGetNon.setAccessible(true);
            }
            Object nonUser = cachedGetNon.invoke(cachedVInstance);
            if (nonUser != null) {
                Log.d(TAG, "Already logged in");
                return;
            }

            // 4. 找 anonymous.a 类
            Class<?> aCls = findClass(cl, "org.swiftapps.swiftbackup.anonymous.a");
            if (aCls == null) {
                aCls = findClass(cl, "org.swiftapps.swiftbackup.anonymous.i");
            }
            if (aCls == null) {
                Log.d(TAG, "anonymous.a not found");
                return;
            }

            // 5. 获取字段 b
            if (cachedAnonHelper == null) {
                Field bField = aCls.getDeclaredField("b");
                bField.setAccessible(true);
                cachedAnonHelper = bField.get(null);
            }
            if (cachedAnonHelper == null) {
                Log.d(TAG, "anonymous.a.b is null");
                return;
            }

            // 6. 调用 d() 获取匿名用户
            if (cachedAnonDMethod == null) {
                cachedAnonDMethod = cachedAnonHelper.getClass().getDeclaredMethod("d");
                cachedAnonDMethod.setAccessible(true);
            }
            Object anonUser = cachedAnonDMethod.invoke(cachedAnonHelper);
            if (anonUser == null) {
                Log.d(TAG, "anonymous user is null");
                return;
            }

            // 7. 获取 setNon 并注入匿名用户
            if (cachedSetNon == null) {
                cachedSetNon = vCls.getDeclaredMethod("setNon", Object.class);
                cachedSetNon.setAccessible(true);
            }
            cachedSetNon.invoke(cachedVInstance, anonUser);
            Log.d(TAG, "anonymous login injected, uid=" + safeUid(anonUser));

        } catch (Throwable t) {
            Log.e(TAG, "ensureLoggedIn failed", t);
        }
    }

    private Class<?> findClass(ClassLoader cl, String name) {
        try {
            return Class.forName(name, false, cl);
        } catch (ClassNotFoundException e) {
            return null;
        }
    }

    private String safeUid(Object user) {
        try {
            Method getUid = user.getClass().getMethod("getUid");
            Object uid = getUid.invoke(user);
            return uid != null ? uid.toString() : "null";
        } catch (Throwable t) {
            return "?";
        }
    }
}